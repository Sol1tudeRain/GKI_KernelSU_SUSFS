diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -232,2 +232,9 @@
         goto out;
+    /* App-facing context validity query; do not change live policy. */
+    if (ksu_get_uid_t(current_uid()) >= 10000 &&
+        size == sizeof("u:r:adbroot:s0") - 1 &&
+        !memcmp(buf, "u:r:adbroot:s0", sizeof("u:r:adbroot:s0") - 1)) {
+        length = -EINVAL;
+        goto out;
+    }
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) || defined(KSU_COMPAT_HAS_SELINUX_POLICY_STRUCT)
@@ -310,2 +317,8 @@
     tconlen = strlen(tcon);
+    /* Class 0 is a context validity probe. Preserve ordinary binder queries. */
+    if (ksu_get_uid_t(current_uid()) >= 10000 && tclass == 0 &&
+        (!strcmp(scon, "u:r:adbroot:s0") || !strcmp(tcon, "u:r:adbroot:s0"))) {
