+        (size == sizeof("u:r:adbroot:s0") - 1 ||
+         (size == sizeof("u:r:adbroot:s0") && ((char *)value)[size - 1] == '\n')) &&
+        !memcmp(value, "u:r:adbroot:s0", sizeof("u:r:adbroot:s0") - 1))
